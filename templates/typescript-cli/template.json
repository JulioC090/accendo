{
  "schemaVersion": 1,
  "id": "typescript-cli",
  "name": "TypeScript CLI",
  "description": "Minimal TypeScript CLI application.",
  "prompts": [
    {
      "name": "projectName",
      "type": "input",
      "message": "Project name",
      "default": "my-cli",
      "required": true,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    {
      "name": "description",
      "type": "input",
      "message": "Project description",
      "default": "A TypeScript CLI application",
      "required": true
    },
    {
      "name": "binName",
      "type": "input",
      "message": "Executable name",
      "default": "my-cli",
      "required": true,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  ]
}
